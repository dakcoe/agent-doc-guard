{
  "description": "Show the rules for agent instruction files before an agent adds to them",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_doc_guard.py\"",
            "timeout": 300,
            "statusMessage": "Checking instruction file edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_doc_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking instruction files after command"
          }
        ]
      }
    ]
  }
}
